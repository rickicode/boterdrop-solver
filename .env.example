# Boterdrop pool — konfigurasi node disimpan di ENV, bukan di repo.
# Format: comma-separated base URL. Urutan = prioritas.
BOTERDROP_URLS=http://node-cloud.example.com:11473,http://10.0.0.10:20011,http://127.0.0.1:20011
# Gateway (opsional, kalau menjalankan pool_gateway.py sebagai reverse proxy)
GATEWAY_PORT=20012
BOTERDROP_NODES=http://node-cloud.example.com:11473,http://10.0.0.10:20011,http://127.0.0.1:20011
